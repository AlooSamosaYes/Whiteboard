{
  "name": "smartboard-whiteboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf node_modules **/*/node_modules"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}